# Playwright environment overrides
# Copy to .env and adjust as needed. Never commit real credentials.

# local | dev | staging
TEST_ENV=local

# Override the environment defaults from e2e/config/environments.ts
# BASE_URL=http://localhost:4000
# API_BASE_URL=http://localhost:3000

# Credentials used by authenticated tests and global setup storage state
# TEST_USER_EMAIL=
# TEST_USER_PASSWORD=
