# Everything listed here is excluded from the build context sent to Docker.
# Keeps builds fast and stops local artefacts leaking into image layers.

# Dependencies are installed inside the image by `npm ci`.
node_modules
npm-debug.log*

# Build output — regenerated by `npm run build` in the builder stage.
dist

# Version control and editor metadata
.git
.gitignore
.github
.vscode
.idea

# Tests and their artefacts — not needed to run the server.
tests
e2e
coverage
playwright-report
test-results
code_reviews
vitest.config.mts
playwright.config.ts

# Local runtime output
logs
*.log

# Secrets and local config — must never be baked into an image.
.env
.env.*

# Docs and tooling config not used at runtime
docs
README.md
Dockerfile
.dockerignore
mcp.json
biome.json
