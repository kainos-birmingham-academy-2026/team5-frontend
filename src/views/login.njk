{% extends "layouts/base.njk" %}

{% block title %}Kainos Careers | Login{% endblock %}

{% block content %}
  <section class="login-page">
    <div class="container login-page-layout">
      <div class="login-page-intro">
        <p class="login-page-eyebrow">Candidate portal</p>
        <h1>Welcome back</h1>
        <p>Sign in to manage your applications and keep your candidate profile up to date.</p>
      </div>

      <div class="login-panel">
        <h2>Sign in</h2>
        <form class="login-form" method="post" action="/login">
          <label class="form-field" for="login-email">
            Email address
            <input id="login-email" name="email" type="email" autocomplete="email" required />
          </label>
          <label class="form-field" for="login-password">
            Password
            <input id="login-password" name="password" type="password" autocomplete="current-password" required />
          </label>
          <button class="btn btn-primary" type="submit">Sign in</button>
        </form>
      </div>
    </div>
  </section>
{% endblock %}