{% extends "layouts/base.njk" %}
{% from "components/ui-macros.njk" import hero, filterBar, jobCard, paginationShell %}

{% block title %}Kainos Careers | Opportunities{% endblock %}

{% block content %}
  {{ hero(
    "Opportunities",
    "Browse open roles",
    "Explore roles across capability areas, locations, bands and closing dates.",
    "Refresh roles",
    "/job-roles",
    "Visit Kainos careers",
    "https://careers.kainos.com/gb/en"
  ) }}

  <section class="container section">
    <h2>Current vacancies</h2>
    {{ filterBar(filterOptions, filters) }}

    {% if jobRoles and jobRoles.length %}
      <div class="job-grid">
        {% for job in jobRoles %}
          {{ jobCard(job) }}
        {% endfor %}
      </div>
      {{ paginationShell(pagination, filterQuery) }}
    {% else %}
      <article class="empty-state">
        <h3>No job roles found</h3>
        <p>Adjust your filters or visit the Kainos careers portal for updated postings.</p>
      </article>
    {% endif %}
  </section>
{% endblock %}
