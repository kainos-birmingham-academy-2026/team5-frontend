{% extends "layouts/base.njk" %}

{% block title %}Kainos Careers | Register{% endblock %}

{% block content %}
  <section class="login-page">
    <div class="container login-page-layout">
      <div class="login-page-intro">
        <p class="login-page-eyebrow">Candidate portal</p>
        <h1>Register</h1>
        <p>Register to manage your applications and keep your candidate profile up to date.</p>
      </div>

      <div class="login-panel">
        <h2>Register</h2>
        {% if errorMessage %}
          <p class="form-error" role="alert">{{ errorMessage }}</p>
        {% endif %}
        <form class="login-form" method="post" action="/register">
          <label class="form-field" for="register-email">
            Email address
            <input id="register-email" name="email" type="email" autocomplete="email" required value="{{ formValues.email }}" />
          </label>
          <label class="form-field" for="register-password">
            Password
            <input id="register-password" name="password" type="password" autocomplete="new-password" required />
          </label>
          <button class="btn btn-primary" type="submit">Register</button>
        </form>
        <p>Already have an account - <a href="/login">Sign In</a></p>
      </div>
    </div>
  </section>
{% endblock %}